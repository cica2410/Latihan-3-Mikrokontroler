#include <Arduino.h>
 
const int LED_MERAH = 4;
const int TOMBOL    = 15;
 
volatile unsigned long cacahISR = 0;
volatile bool adaTekanan = false;
bool nyala = false;
 
void IRAM_ATTR isrTombol() {      // pendek: tanpa Serial, tanpa delay
  cacahISR++;
  adaTekanan = true;
}
 
void setup() {
  Serial.begin(115200);
  delay(1000);
  pinMode(LED_MERAH, OUTPUT);
  pinMode(TOMBOL, INPUT_PULLUP);
  attachInterrupt(digitalPinToInterrupt(TOMBOL), isrTombol, FALLING);
}
 
void loop() {
  if (adaTekanan) {
    adaTekanan = false;           // hapus bendera lebih dahulu
    nyala = !nyala;
    digitalWrite(LED_MERAH, nyala);
    Serial.print("interupsi mencacah: ");
    Serial.println(cacahISR);
  }
 
  delay(300);            // pekerjaan lain yang sama persis
}
